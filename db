═══════════════════════════════════════════════ */

@import url('https://fonts.googleapis.com/css2?family=Playfair+Display+SC:wght@400;700&family=Playfair+Display:ital,wght@0,700;1,400&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Roboto:wght@300;400;600&family=Staatliches&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Geist+Mono:wght@300;400;500&display=swap');
@import url('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css');
@import url('https://cdn.jsdelivr.net/npm/@rolodromo/gameicons-webfont@1.4.0/css/rpgen-gameicons.css');

/* ── WRAPPER PRINCIPAL ── */
.db-wrap {
  width: 700px;
  margin: 0 auto;
  font-family: 'Roboto', sans-serif;
  background: var(--db-bg);
  color: var(--db-text);
  border: 1px solid var(--db-border);
  position: relative;
  overflow: hidden;
}

/* ══ 1. CABECERA ══════════════════════════════ */
.db-header {
  width: 100%;
  padding: 48px 0 36px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  position: relative;
  overflow: hidden;
  gap: 0;
}

.db-header::before {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--db-header-overlay);
  z-index: 0;
}

.db-header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60%;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--db-accent), transparent);
}

.db-header > * { position: relative; z-index: 1; }

.db-pretitle {
  font-family: 'Geist Mono', monospace;
  font-size: 8px;
  letter-spacing: 5px;
  text-transform: uppercase;
  color: var(--db-muted);
  margin: 0 0 6px 0;
  opacity: 0.9;
}

/* TÍTULO con efecto shimmer */
.db-title {
  font-family: 'Playfair Display', serif;
  font-size: 62px;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -1px;
  margin: 0;
  background: linear-gradient(
    90deg,
    var(--db-title-c1) 0%,
    var(--db-title-c2) 40%,
    var(--db-accent) 60%,
    var(--db-title-c1) 100%
  );
  background-size: 300% auto;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: db-shimmer 5s linear infinite;
}

@keyframes db-shimmer {
  0%   { background-position: 0% center; }
  100% { background-position: 300% center; }
}

.db-subtitle {
  font-family: 'Geist Mono', monospace;
  font-size: 8px;
  letter-spacing: 5px;
  text-transform: uppercase;
  color: var(--db-muted);
  margin: 6px 0 0 0;
  opacity: 0.9;
}

/* ══ 2. QUOTE ════════════════════════════════ */
.db-quote-wrap {
  padding: 36px 60px 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  width: 100%;
  box-sizing: border-box;
}

.db-quote-icon {
  font-size: 16px;
  color: var(--db-accent);
  opacity: 0.35;
  flex-shrink: 0;
  line-height: 1;
}

.db-quote {
  font-family: 'Cormorant Garamond', serif;
  font-size: 13px;
  font-weight: 300;
  font-style: italic;
  line-height: 1.8;
  letter-spacing: 0.5px;
  color: var(--db-muted);
  text-align: center;
  margin: 0;
  padding: 0;
  max-width: 440px;
}

/* ══ 4. RESUMEN ══════════════════════════════ */
.db-section {
  padding: 0 40px 30px;
  width: 100%;
  box-sizing: border-box;
}

/* Encabezado de sección estilo Romance */
.db-section-label {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 16px;
}

.db-section-label b {
  font-family: 'Playfair Display SC', serif;
  font-size: 34px;
  font-weight: 700;
  line-height: 1;
  color: transparent;
  -webkit-text-stroke: 0.5px var(--db-accent);
  text-shadow: 1px 1px 0 var(--db-accent-dim);
  text-transform: uppercase;
  letter-spacing: 2px;
}

.db-section-label i {
  font-family: 'Staatliches', sans-serif;
  font-size: 9px;
  font-weight: 400;
  font-style: normal;
  letter-spacing: 5px;
  text-transform: uppercase;
  color: var(--db-muted);
  margin-top: 1px;
}

.db-section-label::after {
  content: '';
  display: block;
  width: 100%;
  height: 1px;
  background: var(--db-border);
  margin-top: 10px;
}

.db-resumen {
  font-family: 'Roboto', sans-serif;
  font-size: 11px;
  font-weight: 300;
  line-height: 18px;
  letter-spacing: 0.5px;
  color: var(--db-body);
  text-align: justify;
  margin: 0;
}

.db-resumen strong { font-weight: 600; color: var(--db-accent); }
.db-resumen em     { font-style: italic; color: var(--db-silver); font-weight: 300; }
.db-resumen s      { text-decoration: line-through; text-decoration-color: var(--db-accent); opacity: 0.6; }
.db-resumen u      { text-decoration: underline dotted var(--db-accent); text-underline-offset: 3px; }

/* ══ 5. CARDS DE PERSONAJES ═════════════════ */
.db-cards-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
  padding: 0 40px 30px;
  width: 100%;
  box-sizing: border-box;
}

.db-card {
  aspect-ratio: 3 / 2;
  position: relative;
  overflow: hidden;
  background: #0a0a0a;
  cursor: pointer;
  border: 1px solid var(--db-border);
}

.db-card-imgwrap {
  position: absolute;
  inset: -18%;
  transition: transform 1s cubic-bezier(0.33, 1, 0.68, 1), filter 1s ease;
  transform: rotate(8deg) scale(1.1);
  transform-origin: center center;
  filter: grayscale(50%) brightness(0.7);
}

.db-card-imgwrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.db-card:hover .db-card-imgwrap {
  transform: rotate(0deg) scale(1);
  filter: grayscale(0%) brightness(0.45);
}

.db-card-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(160deg, var(--db-accent-dim) 0%, rgba(10,10,10,0.88) 100%);
  opacity: 0;
  transition: opacity 0.8s ease;
  z-index: 1;
}

.db-card:hover .db-card-overlay { opacity: 1; }

.db-card-line {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  top: -60px;
  width: 1px;
  height: 28px;
  background: linear-gradient(180deg, transparent, var(--db-accent));
  z-index: 2;
  transition: top 0.8s cubic-bezier(0.33, 1, 0.68, 1);
  transition-delay: 0.1s;
}

.db-card:hover .db-card-line { top: calc(50% - 44px); }

.db-card-over {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 3;
  transform: translateY(12px);
  opacity: 0;
  transition: transform 0.7s cubic-bezier(0.33, 1, 0.68, 1), opacity 0.7s ease;
  transition-delay: 0.15s;
  text-align: center;
  padding: 0 10px;
}

.db-card:hover .db-card-over {
  transform: translateY(0);
  opacity: 1;
}

.db-card-name {
  font-family: 'Playfair Display', serif;
  font-size: 14px;
  font-weight: 700;
  font-style: italic;
  color: #fff;
  line-height: 1.1;
  display: block;
  margin-bottom: 5px;
  margin-top: 10px;
}

.db-card-info {
  font-family: 'Staatliches', sans-serif;
  font-size: 8px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--db-accent);
  display: block;
  filter: brightness(1.3);
}

.db-card-num {
  position: absolute;
  top: 10px;
  right: 10px;
  font-family: 'Geist Mono', monospace;
  font-size: 8px;
  letter-spacing: 2px;
  color: var(--db-accent);
  opacity: 0.4;
  z-index: 3;
  transition: opacity 0.5s ease;
}

.db-card:hover .db-card-num { opacity: 0; }

/* ══ 6. CAPÍTULOS — estilo Romance ══════════ */
.db-chapters {
  padding: 0 40px 30px;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.db-chapter-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 7px 0;
  border-bottom: 1px solid var(--db-border);
  text-decoration: none;
  transition: padding-left 0.3s ease;
  background: transparent;
}

.db-chapter-row:hover { padding-left: 5px; }

.db-chapter-num {
  font-family: 'Staatliches', sans-serif;
  font-size: 10px;
  letter-spacing: 2px;
  color: var(--db-accent);
  opacity: 0.65;
  min-width: 20px;
  text-align: right;
}

.db-chapter-dot {
  width: 3px;
  height: 3px;
  background: var(--db-border);
  border-radius: 50%;
  flex-shrink: 0;
}

.db-chapter-link {
  font-family: 'Roboto', sans-serif;
  font-size: 10px;
  font-weight: 300;
  letter-spacing: 1px;
  color: var(--db-silver);
  text-decoration: none;
  flex: 1;
  transition: color 0.3s ease;
}

.db-chapter-row:hover .db-chapter-link { color: var(--db-accent); }

.db-chapter-chars {
  font-family: 'Staatliches', sans-serif;
  font-size: 9px;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: var(--db-muted);
}

.db-chapter-status {
  font-size: 7px;
  line-height: 1;
  display: flex;
  align-items: center;
}

/* ══ PIE DE PÁGINA ════════════════════════════ */
.db-footer {
  border-top: 1px solid var(--db-border);
  padding: 14px 40px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--db-footer-bg);
  width: 100%;
  box-sizing: border-box;
}

.db-credits {
  font-family: 'Staatliches', sans-serif;
  font-size: 10px;
  letter-spacing: 5px;
  text-transform: uppercase;
  opacity: 0.35;
  color: var(--db-text);
}

.db-credits a {
  color: var(--db-accent) !important;
  text-decoration: none;
  transition: opacity 0.3s;
}

.db-credits a:hover { opacity: 0.6; }

.db-footer-phrase {
  font-family: 'Roboto', sans-serif;
  font-size: 9px;
  font-weight: 300;
  letter-spacing: 0.5px;
  color: var(--db-muted);
  text-align: right;
  max-width: 350px;
  line-height: 15px;
}

/* ══ SEPARADOR INTERNO ════════════════════════ */
.db-divider {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  padding: 18px 0;
  box-sizing: border-box;
}

.db-divider::before,
.db-divider::after {
  content: '';
  flex: 1;
  max-width: 200px;
  height: 1px;
  background: var(--db-border);
}

.db-divider-icon {
  font-size: 13px;
  color: var(--db-accent);
  opacity: 0.45;
  line-height: 1;
}
